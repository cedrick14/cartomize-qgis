<UserControl x:Class="Cartomize.ArcGISPro.Views.CartomizeContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- ArcGIS Pro fournit les couleurs, les polices et les états bleus de sélection. -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Esri_BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,11,12,12" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0"
            Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
            BorderBrush="{DynamicResource Esri_BorderBrush}"
            BorderThickness="0,0,0,1" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="56" Height="56"
               Source="/Cartomize.ArcGISPro;component/Images/Cartomize.png" Stretch="Uniform" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Cartomize" Style="{DynamicResource Esri_TextBlockDockPaneHeading}" />
          <TextBlock Text="Automatisation et mise en page pour ArcGIS Pro"
                     Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
                BorderThickness="0" TabStripPlacement="Top">
      <TabItem Header="Automatisation">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Automatisation" Style="{DynamicResource Esri_TextBlockH1}" Margin="0,0,0,4" />
            <TextBlock Text="Analysez le projet, comparez plusieurs propositions et créez une carte ArcGIS Pro native en suivant un plan explicable."
                       Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Préparer l’analyse" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Définissez l’objectif et les données à prendre en compte. Les valeurs automatiques conviennent à la plupart des projets."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Content="Objectif" Margin="0,6,12,0" />
                  <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding Objectives}"
                            SelectedItem="{Binding SelectedObjective}" />
                  <Label Grid.Row="1" Content="Couche principale" Margin="0,6,12,0" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LayerChoices}" SelectedItem="{Binding SelectedLayerChoice}" />
                  <Label Grid.Row="2" Content="Style de composition" Margin="0,6,12,0" />
                  <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StyleProfiles}"
                            SelectedItem="{Binding SelectedStyleProfile}" />
                  <Label Grid.Row="3" Content="Sources" Margin="0,6,12,0" />
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding AutomationSources, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Sources, année et crédits cartographiques" />
                </Grid>
                <CheckBox Content="Utiliser les couches affichées dans ArcGIS Pro" IsChecked="{Binding AutomationVisibleOnly}" />
                <CheckBox Content="Harmoniser la symbologie du projet (peut remplacer les styles actuels)" IsChecked="{Binding AutomationApplySymbology}" />
                <CheckBox Content="Corriger automatiquement la lisibilité" IsChecked="{Binding AutomationAutoCorrect}" />
                <Button Content="Analyser le projet" Command="{Binding AnalyzeAutomationCommand}"
                        Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Plan cartographique recommandé" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Le rapport présente les décisions proposées avant toute modification du projet."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <TextBox Text="{Binding AutomationReportText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="170" />
                <ProgressBar Minimum="0" Maximum="100" Value="0" MinHeight="18" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Propositions" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Comparez les variantes selon leur score, leur maquette et les principales décisions de composition."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <DataGrid Height="220" ItemsSource="{Binding Proposals}" SelectedItem="{Binding SelectedProposal}"
                          Style="{DynamicResource Esri_DataGrid}" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Score" Width="Auto" Binding="{Binding Score}" />
                    <DataGridTextColumn Header="Proposition" Width="Auto" Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Maquette" Width="Auto" Binding="{Binding TemplateName}" />
                    <DataGridTextColumn Header="Format" Width="Auto" Binding="{Binding PageFormat}" />
                    <DataGridTextColumn Header="Décisions" Width="*" Binding="{Binding Decisions}" />
                  </DataGrid.Columns>
                </DataGrid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Content="Maquette" Margin="0,6,12,0" /><ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding FilteredTemplates}" SelectedItem="{Binding SelectedTemplate}" />
                  <Label Grid.Row="1" Content="Titre" Margin="0,6,12,0" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LayoutTitle, UpdateSourceTrigger=PropertyChanged}" />
                  <Label Grid.Row="2" Content="Sous-titre" Margin="0,6,12,0" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LayoutSubtitle, UpdateSourceTrigger=PropertyChanged}" />
                  <Label Grid.Row="3" Content="Marge d’emprise" Margin="0,6,12,0" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LayoutMargin, UpdateSourceTrigger=PropertyChanged}" />
                  <Label Grid.Row="4" Content="Contexte cartographique" Margin="0,6,12,0" /><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ContextChoices}" SelectedItem="{Binding SelectedContextChoice}" />
                  <Label Grid.Row="5" Content="Opacité du contexte" Margin="0,6,12,0" /><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ContextOpacity, UpdateSourceTrigger=PropertyChanged}" />
                  <Label Grid.Row="6" Content="Carte de situation" Margin="0,6,12,0" /><ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding MapNames}" SelectedItem="{Binding LocatorMapName}" />
                  <Label Grid.Row="7" Content="Grille" Margin="0,6,12,0" /><CheckBox Grid.Row="7" Grid.Column="1" Content="Afficher une grille de coordonnées" IsChecked="{Binding LayoutAddGrid}" />
                  <Label Grid.Row="8" Content="Validation" Margin="0,6,12,0" /><CheckBox Grid.Row="8" Grid.Column="1" Content="Décisions vérifiées par le cartographe" IsChecked="{Binding ProposalValidated}" />
                </Grid>
                <Button Content="Créer la proposition sélectionnée" Command="{Binding AutopilotCommand}"
                        Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Button Content="Créer les trois propositions" Command="{Binding GenerateAllCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Recettes réutilisables" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Enregistrez les décisions cartographiques pour reproduire la même carte avec de nouvelles données."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button Content="Enregistrer la recette" Command="{Binding SaveRecipeCommand}"
                          Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Rejouer une recette" Command="{Binding ReplayCommand}"
                          Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="4,3,0,3" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Projet">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Projet" Style="{DynamicResource Esri_TextBlockH1}" Margin="0,0,0,4" />
            <TextBlock Text="Consultez l’état du projet, sélectionnez une couche et appliquez une recommandation de symbologie réversible."
                       Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Vue d’ensemble du projet" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBox Text="{Binding ProjectSummary, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="150" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Couche active" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Les actions utilisent la couche choisie ici, sans modifier les autres couches du projet."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Label Content="Couche" Margin="0,6,12,0" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding LayerChoices}" SelectedItem="{Binding SelectedLayerChoice}" />
                </Grid>
                <Button Content="Importer des données…" Command="{Binding ImportDataCommand}"
                        Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button Content="Afficher l’emprise" Command="{Binding ZoomLayerCommand}"
                          Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Ouvrir les propriétés" Command="{Binding LayerPropertiesCommand}"
                          Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="4,3,0,3" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Recommandation de symbologie" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="L’analyse est lancée uniquement sur demande afin de préserver la réactivité d’ArcGIS Pro, y compris avec des couches volumineuses ou distantes."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Button Content="Analyser la couche sélectionnée" Command="{Binding AnalyzeLayerCommand}"
                        Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <TextBox Text="{Binding RecommendationText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="190" />
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Mode de rendu" Margin="0,6,12,0" />
                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding RenderModes}" SelectedItem="{Binding SelectedRenderMode}" />
                    <Label Grid.Row="1" Content="Champ thématique" Margin="0,6,12,0" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LayerFields}" SelectedItem="{Binding SelectedThematicField}" />
                    <Label Grid.Row="2" Content="Nombre maximal de classes" Margin="0,6,12,0" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MaxClasses, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="3" Content="Palette" Margin="0,6,12,0" />
                    <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding PaletteChoices}" SelectedItem="{Binding SelectedPalette}" />
                    <Label Grid.Row="4" Content="Champ d’étiquette" Margin="0,6,12,0" /><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding LayerFields}" SelectedItem="{Binding SelectedLabelField}" />
                    <Label Grid.Row="5" Content="Étiquetage" Margin="0,6,12,0" /><CheckBox Grid.Row="5" Grid.Column="1" Content="Activer les étiquettes" IsChecked="{Binding LabelsEnabled}" />
                    <Label Grid.Row="6" Content="Taille des étiquettes" Margin="0,6,12,0" /><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding LabelSize, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="7" Content="Placement" Margin="0,6,12,0" />
                    <ComboBox Grid.Row="7" Grid.Column="1" ItemsSource="{Binding PlacementChoices}" SelectedItem="{Binding SelectedPlacement}" />
                    <Label Grid.Row="8" Content="Opacité de la couche" Margin="0,6,12,0" /><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding LayerOpacity, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Row="9" Content="Validation" Margin="0,6,12,0" /><CheckBox Grid.Row="9" Grid.Column="1" Content="Confirmer les paramètres avant application" IsChecked="{Binding ConfirmStyleParameters}" />
                  </Grid>
                </Border>
                <Button Content="Appliquer la recommandation" Command="{Binding ApplyRecommendationCommand}"
                        Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Button Content="Restaurer le style précédent" Command="{Binding UndoStyleCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Button Content="Ouvrir Raster Engine" Command="{Binding RasterCommand}"
                        IsEnabled="{Binding IsRasterLayer}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Mise en page">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Mise en page" Style="{DynamicResource Esri_TextBlockH1}" Margin="0,0,0,4" />
            <TextBlock Text="Choisissez une maquette, renseignez les informations essentielles et produisez une mise en page ArcGIS Pro native entièrement modifiable."
                       Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Catalogue de maquettes" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Utilisez la recherche et les catégories pour parcourir les maquettes ArcGIS Pro disponibles hors connexion."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Label Content="Recherche" /><Label Grid.Column="1" Content="Catégorie" Margin="8,0,0,0" />
                  <TextBox Grid.Row="1" Text="{Binding TemplateSearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Rechercher par titre, thème ou usage" />
                  <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" ItemsSource="{Binding TemplateCategories}" SelectedItem="{Binding SelectedTemplateCategory}" />
                </Grid>
                <ListBox Height="190" Margin="0,8,0,8" ItemsSource="{Binding FilteredTemplates}" SelectedItem="{Binding SelectedTemplate}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" />
                <TextBlock Text="Détails de la maquette" Style="{DynamicResource Esri_TextBlockRegular}" />
                <TextBox Text="{Binding TemplateDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="145" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Contenu de la carte" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Ces informations sont ajoutées à la composition et restent modifiables dans le concepteur ArcGIS Pro."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Content="Titre" Margin="0,6,12,0" /><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LayoutTitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Titre principal de la carte" />
                  <Label Grid.Row="1" Content="Sous-titre" Margin="0,6,12,0" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding LayoutSubtitle, UpdateSourceTrigger=PropertyChanged}" ToolTip="Sous-titre ou période d’analyse" />
                  <Label Grid.Row="2" Content="Sources" Margin="0,6,12,0" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LayoutSources, UpdateSourceTrigger=PropertyChanged}" ToolTip="Sources, auteur et date" />
                  <Label Grid.Row="3" Content="Marge cartographique" Margin="0,6,12,0" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LayoutMargin, UpdateSourceTrigger=PropertyChanged}" />
                  <Label Grid.Row="4" Content="Contexte cartographique" Margin="0,6,12,0" /><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding ContextChoices}" SelectedItem="{Binding SelectedContextChoice}" />
                  <Label Grid.Row="5" Content="Opacité du contexte" Margin="0,6,12,0" /><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ContextOpacity, UpdateSourceTrigger=PropertyChanged}" />
                  <Label Grid.Row="6" Content="Carte de situation" Margin="0,6,12,0" /><ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding MapNames}" SelectedItem="{Binding LocatorMapName}" />
                </Grid>
                <CheckBox Content="Utiliser les couches affichées dans ArcGIS Pro" IsChecked="{Binding LayoutVisibleOnly}" />
                <CheckBox Content="Ajouter une grille au cadre principal" IsChecked="{Binding LayoutAddGrid}" />
                <Button Content="Créer la mise en page" Command="{Binding LayoutCommand}" Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Button Content="Actualiser la mise en page" Command="{Binding SynchronizeLayoutCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Button Content="Ouvrir l’aperçu HD dans ArcGIS Pro" Command="{Binding OpenLayoutCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Aperçu et export" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Sélectionnez une mise en page existante, améliorez son rendu puis choisissez un format de sortie."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Label Content="Mise en page" Margin="0,6,12,0" /><ComboBox Grid.Column="1" ItemsSource="{Binding LayoutNames}" SelectedItem="{Binding SelectedLayoutName}" />
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button Content="Actualiser l’aperçu HD" Command="{Binding RefreshPreviewCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Améliorer la lisibilité" Command="{Binding OptimizeLayoutCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="4,3,0,3" />
                </Grid>
                <TextBlock Text="Formats de sortie" Style="{DynamicResource Esri_TextBlockRegular}" Margin="0,6,0,2" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Button Content="Exporter en PDF" Command="{Binding ExportPdfCommand}" Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Exporter en SVG" Command="{Binding ExportSvgCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="4,3,0,3" />
                  <Button Grid.Row="1" Content="Exporter en PNG" Command="{Binding ExportPngCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="0,3,4,3" />
                  <Button Grid.Row="1" Grid.Column="1" Content="Enregistrer en PAGX" Command="{Binding ExportPagxCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="4,3,0,3" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Qualité">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Qualité" Style="{DynamicResource Esri_TextBlockH1}" Margin="0,0,0,4" />
            <TextBlock Text="Contrôlez la cohérence du projet et des mises en page avant publication. Chaque anomalie est accompagnée d’une action recommandée."
                       Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Résultat du contrôle" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="{Binding AuditScoreText}" Style="{DynamicResource Esri_TextBlockH1}" />
                <Button Content="Lancer le contrôle de la qualité" Command="{Binding AuditCommand}" Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Button Content="Vérifier le placement des étiquettes" Command="{Binding LabelAuditCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <TextBlock Text="{Binding LabelAuditText}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Observations" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Sélectionnez une ligne pour examiner le niveau, la couche concernée et la correction proposée."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <DataGrid Height="330" ItemsSource="{Binding AuditFindings}"
                          Style="{DynamicResource Esri_DataGrid}" SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" AutoGenerateColumns="False" CanUserAddRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Niveau" Width="Auto" Binding="{Binding Severity}" /><DataGridTextColumn Header="Code" Width="Auto" Binding="{Binding Code}" />
                    <DataGridTextColumn Header="Couche" Width="Auto" Binding="{Binding Layer}" /><DataGridTextColumn Header="Observation et action recommandée" Width="*" Binding="{Binding Summary}" />
                  </DataGrid.Columns>
                </DataGrid>
                <Button Content="Copier le rapport" Command="{Binding CopyReportCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Production">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Production" Style="{DynamicResource Esri_TextBlockH1}" Margin="0,0,0,4" />
            <TextBlock Text="Produisez des séries de cartes, surveillez les changements du projet et formalisez la validation du cartographe."
                       Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Production en série" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Un manifeste JSON décrit les cartes à produire, les variables et les formats de sortie."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding BatchManifestPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Chemin du manifeste de production" /><Button Grid.Column="1" Content="Parcourir" Command="{Binding SelectManifestCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="8,3,0,3" />
                </Grid>
                <Button Content="Créer un manifeste" Command="{Binding CreateManifestCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Button Content="Exécuter la série" Command="{Binding BatchCommand}" Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <TextBox Text="{Binding BatchStatusText, Mode=OneWay}"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="135" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Suivi MapOps" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="Comparez l’état actuel du projet à une référence et identifiez les cartes à régénérer."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Button Content="Créer l’état de référence" Command="{Binding CreateMapOpsBaselineCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Vérifier les changements" Command="{Binding CheckMapOpsCommand}" Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="4,3,0,3" />
                  <Button Grid.Row="1" Content="Accepter l’état actuel" Command="{Binding AcceptMapOpsCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="0,3,4,3" />
                  <Button Grid.Row="1" Grid.Column="1" Content="Régénérer la dernière recette" Command="{Binding RegenerateMapOpsCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" Margin="4,3,0,3" />
                </Grid>
                <CheckBox Content="Régénérer automatiquement la dernière recette lorsque des données utilisées changent" IsChecked="{Binding MapOpsAutoRegenerate}" />
                <TextBox Text="{Binding MapOpsStatus, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Validation cartographique" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
                <TextBlock Text="L’approbation humaine reste distincte du score automatique et produit un certificat traçable."
                           Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Label Content="Réviseur" Margin="0,6,12,0" /><TextBox Grid.Column="1" Text="{Binding ValidationReviewer, UpdateSourceTrigger=PropertyChanged}" ToolTip="Nom du cartographe responsable" />
                  <Label Grid.Row="1" Content="Organisation" Margin="0,6,12,0" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ValidationOrganization, UpdateSourceTrigger=PropertyChanged}" ToolTip="Organisation" />
                </Grid>
                <TextBlock Text="Liste de contrôle obligatoire" Style="{DynamicResource Esri_TextBlockRegular}" Margin="0,8,0,2" />
                <CheckBox Content="Les sources, dates et limites des données sont vérifiées." IsChecked="{Binding CheckSources}" />
                <CheckBox Content="Le CRS, l’emprise et l’échelle correspondent à l’objectif de la carte." IsChecked="{Binding CheckCrs}" />
                <CheckBox Content="La symbologie représente correctement les variables et les classes." IsChecked="{Binding CheckSymbology}" />
                <CheckBox Content="Les étiquettes sont lisibles, sans ambiguïté ni collision majeure." IsChecked="{Binding CheckLabels}" />
                <CheckBox Content="Le titre, la légende, l’échelle, le nord et les crédits sont cohérents." IsChecked="{Binding CheckLayout}" />
                <CheckBox Content="Le contraste, la taille des textes et les couleurs sont accessibles." IsChecked="{Binding CheckAccessibility}" />
                <CheckBox Content="Le fichier exporté a été ouvert et contrôlé au niveau de zoom requis." IsChecked="{Binding CheckExport}" />
                <TextBlock Text="Notes et réserves" Style="{DynamicResource Esri_TextBlockRegular}" Margin="0,8,0,2" />
                <TextBox Text="{Binding ValidationNotes, UpdateSourceTrigger=PropertyChanged}" ToolTip="Précisez les limites des données, les réserves ou les corrections demandées."
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
                <Button Content="Approuver la mise en page" Command="{Binding ApproveLayoutCommand}" Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <Button Content="Exporter le certificat" Command="{Binding ExportCertificateCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
                <TextBlock Text="{Binding ValidationStatus}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Communauté">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Communauté" Style="{DynamicResource Esri_TextBlockH1}" Margin="0,0,0,4" />
            <TextBlock Text="Accédez au portail officiel Cartomize et aux maquettes disponibles hors ligne."
                       Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}"><StackPanel>
              <TextBlock Text="Portail Cartomize" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
              <TextBlock Text="Consultez les maquettes publiées et les ressources de la communauté." Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="Le portail s’ouvre dans votre navigateur. Aucune donnée du projet ArcGIS Pro n’est transmise." TextWrapping="Wrap" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
              <TextBlock Text="Maquettes hors ligne" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
              <TextBlock Text="{Binding CommunityStatus}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <TextBlock Text="Elles restent accessibles lorsque le portail ou Internet est indisponible." Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
              <TextBlock Text="Ressources en ligne" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
              <TextBlock Text="Actualisez la liste des ressources publiées sur le portail officiel." Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
              <ListBox Height="190" ItemsSource="{Binding CommunityResources}" SelectedItem="{Binding SelectedCommunityResource}"
                       VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                       ScrollViewer.CanContentScroll="True" />
              <Button Content="Actualiser le catalogue en ligne" Command="{Binding RefreshCommunityCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
              <Button Content="Ouvrir la ressource sélectionnée" Command="{Binding OpenCommunityResourceCommand}" Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
              <Button Content="Ouvrir le portail Cartomize" Command="{Binding CommunityCommand}" Style="{DynamicResource Esri_ButtonBorderless}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Système">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Système" Style="{DynamicResource Esri_TextBlockH1}" Margin="0,0,0,4" />
            <TextBlock Text="Vérifiez la disponibilité des composants ArcGIS Pro requis et consultez l’état technique du plugin."
                       Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Border Style="{StaticResource CardStyle}"><StackPanel>
              <TextBlock Text="Diagnostic" Style="{DynamicResource Esri_TextBlockH3}" Margin="0,0,0,5" />
              <TextBox Text="{Binding DiagnosticText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="360" />
              <Button Content="Actualiser l’état du système" Command="{Binding DiagnosticsCommand}" Style="{DynamicResource Esri_Button}" Padding="10,5" MinHeight="32" HorizontalContentAlignment="Center" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2"
            Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
            BorderBrush="{DynamicResource Esri_BorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,5">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding FooterStatus}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding VersionText}" Style="{DynamicResource Esri_TextBlockH7}" Margin="8,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
