<UserControl x:Class="Cartomize.ArcGISPro.Views.CartomizeDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420">
  <!--
    L'interface utilise exclusivement les ressources dynamiques du thème
    ArcGIS Pro. Les polices, couleurs, fonds et états de sélection s'adaptent
    automatiquement aux thèmes clair, sombre et contraste élevé.
  -->
  <Grid Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
            BorderBrush="{DynamicResource Esri_BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="56" Height="56"
               Source="/Cartomize.ArcGISPro;component/Images/Cartomize.png"
               Stretch="Uniform" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Cartomize"
                     Style="{DynamicResource Esri_TextBlockDockPaneHeading}" />
          <TextBlock Text="Outils cartographiques pour ArcGIS Pro"
                     Style="{DynamicResource Esri_TextBlockRegular}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1"
                Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
                BorderThickness="0">
      <TabItem Header="Automatisation">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Automatisation" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Créez une carte à partir du projet actif."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Création de carte" Style="{DynamicResource Esri_TextBlockH3}" />
                <Button Content="Créer une carte" Command="{Binding AutopilotCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,6,0,4" />
                <Button Content="Rejouer une recette" Command="{Binding ReplayCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Projet">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Projet" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Analysez les couches du projet."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Analyse des données" Style="{DynamicResource Esri_TextBlockH3}" />
                <Button Content="Analyser une couche vectorielle" Command="{Binding VectorCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,6,0,4" />
                <Button Content="Analyser un raster" Command="{Binding RasterCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4" />
                <Button Content="Analyser le projet" Command="{Binding GeoCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Mise en page">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Mise en page" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Créez une mise en page à partir d’une maquette."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Maquettes" Style="{DynamicResource Esri_TextBlockH3}" />
                <TextBlock Text="24 maquettes Cartomize sont disponibles hors connexion."
                           Style="{DynamicResource Esri_TextBlockRegular}"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <Button Content="Créer une mise en page" Command="{Binding LayoutCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Qualité">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Qualité" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Contrôlez le projet avant publication."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Contrôles" Style="{DynamicResource Esri_TextBlockH3}" />
                <Button Content="Contrôler le projet" Command="{Binding AuditCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,6,0,4" />
                <Button Content="Vérifier les changements" Command="{Binding MapOpsCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Production">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Production" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Produisez plusieurs cartes."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Production" Style="{DynamicResource Esri_TextBlockH3}" />
                <Button Content="Produire une série de cartes" Command="{Binding BatchCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,6,0,4" />
                <Button Content="Rejouer une recette" Command="{Binding ReplayCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Communauté">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Communauté" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Accédez aux ressources Cartomize."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Ressources" Style="{DynamicResource Esri_TextBlockH3}" />
                <Button Content="Ouvrir le portail" Command="{Binding CommunityCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Système">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Système" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Vérifiez les composants Cartomize."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Environnement" Style="{DynamicResource Esri_TextBlockH3}" />
                <TextBlock Text="ArcGIS Pro 3.7&#x0a;.NET 10&#x0a;24 maquettes hors ligne&#x0a;Boîte à outils Python Cartomize"
                           Style="{DynamicResource Esri_TextBlockRegular}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2"
            Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
            BorderBrush="{DynamicResource Esri_BorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,6">
      <TextBlock Text="{Binding VersionText}"
                 Style="{DynamicResource Esri_TextBlockH7}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
