<UserControl x:Class="Cartomize.ArcGISPro.Views.CartomizeDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420">
  <!--
    L'interface utilise exclusivement les ressources dynamiques du thème
    ArcGIS Pro. Les polices, couleurs, fonds et états de sélection s'adaptent
    automatiquement aux thèmes clair, sombre et contraste élevé.
  -->
  <Grid Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
            BorderBrush="{DynamicResource Esri_BorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="56" Height="56"
               Source="/Cartomize.ArcGISPro;component/Images/Cartomize.png"
               Stretch="Uniform" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Cartomize"
                     Style="{DynamicResource Esri_TextBlockDockPaneHeading}" />
          <TextBlock Text="Automatisation et mise en page pour ArcGIS Pro"
                     Style="{DynamicResource Esri_TextBlockRegular}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1"
                Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
                BorderThickness="0">
      <TabItem Header="Automatisation">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Automatisation" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Analysez le projet et créez une carte ArcGIS Pro native en suivant un flux explicable."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Automatisation cartographique" Style="{DynamicResource Esri_TextBlockH3}" />
                <TextBlock Text="Les outils utilisent les cartes, couches et maquettes du projet courant."
                           Style="{DynamicResource Esri_TextBlockRegular}"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <Button Content="Créer automatiquement une carte" Command="{Binding AutopilotCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4" />
                <Button Content="Rejouer une recette Cartomize" Command="{Binding ReplayCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Projet">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Projet" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Consultez le projet, analysez une couche et appliquez des traitements Cartomize réversibles."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Intelligence cartographique" Style="{DynamicResource Esri_TextBlockH3}" />
                <TextBlock Text="Sélectionnez les données dans les outils ArcGIS Pro avant l’exécution."
                           Style="{DynamicResource Esri_TextBlockRegular}"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <Button Content="Analyser une couche avec Vector Intelligence" Command="{Binding VectorCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4" />
                <Button Content="Analyser un raster avec Raster Engine" Command="{Binding RasterCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,0,0,4" />
                <Button Content="Analyser l’intelligence cartographique du projet" Command="{Binding GeoCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Mise en page">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Mise en page" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Choisissez une maquette et produisez une mise en page ArcGIS Pro native entièrement modifiable."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Catalogue de maquettes" Style="{DynamicResource Esri_TextBlockH3}" />
                <TextBlock Text="24 maquettes Cartomize sont disponibles hors connexion."
                           Style="{DynamicResource Esri_TextBlockRegular}"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <Button Content="Créer une mise en page Cartomize" Command="{Binding LayoutCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Qualité">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Qualité" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Contrôlez la cohérence du projet et surveillez les changements avant publication."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Contrôle de la qualité" Style="{DynamicResource Esri_TextBlockH3}" />
                <Button Content="Contrôler la qualité cartographique du projet" Command="{Binding AuditCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,6,0,4" />
                <Button Content="Vérifier les changements MapOps" Command="{Binding MapOpsCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Production">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Production" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Produisez des séries de cartes et rejouez les décisions cartographiques enregistrées."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Production en série" Style="{DynamicResource Esri_TextBlockH3}" />
                <Button Content="Produire une série de cartes Cartomize" Command="{Binding BatchCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" Margin="0,6,0,4" />
                <Button Content="Rejouer une recette Cartomize" Command="{Binding ReplayCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Communauté">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Communauté" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Accédez au portail officiel Cartomize et aux ressources de la communauté."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Portail Cartomize" Style="{DynamicResource Esri_TextBlockH3}" />
                <TextBlock Text="Aucune donnée du projet ArcGIS Pro n’est transmise au portail."
                           Style="{DynamicResource Esri_TextBlockRegular}"
                           TextWrapping="Wrap" Margin="0,4,0,8" />
                <Button Content="Ouvrir le portail Cartomize" Command="{Binding CommunityCommand}"
                        Style="{DynamicResource Esri_ButtonBorderless}"
                        HorizontalContentAlignment="Left" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Système">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Système" Style="{DynamicResource Esri_TextBlockH1}" />
            <TextBlock Text="Vérifiez la disponibilité des composants requis et l’état technique de Cartomize."
                       Style="{DynamicResource Esri_TextBlockRegular}"
                       TextWrapping="Wrap" Margin="0,4,0,14" />
            <Border BorderBrush="{DynamicResource Esri_BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="0,12,0,6">
              <StackPanel>
                <TextBlock Text="Diagnostic" Style="{DynamicResource Esri_TextBlockH3}" />
                <TextBlock Text="ArcGIS Pro 3.7&#x0a;.NET 10&#x0a;24 maquettes hors ligne&#x0a;Boîte à outils Python Cartomize"
                           Style="{DynamicResource Esri_TextBlockRegular}"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2"
            Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
            BorderBrush="{DynamicResource Esri_BorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,6">
      <TextBlock Text="{Binding VersionText}"
                 Style="{DynamicResource Esri_TextBlockH7}"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
