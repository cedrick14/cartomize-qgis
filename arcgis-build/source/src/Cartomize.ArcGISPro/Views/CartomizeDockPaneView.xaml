<UserControl x:Class="Cartomize.ArcGISPro.Views.CartomizeDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420"
             Background="#FFFFFF"
             FontFamily="Segoe UI">
  <UserControl.Resources>
    <!-- Palette officielle utilisée par Cartomize QGIS 10.5.1. -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#0F6CBD" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0B5CA8" />
    <SolidColorBrush x:Key="NavyBrush" Color="#132C56" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="LineBrush" Color="#DDE4EF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#F5F7FB" />

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="PageDescription" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="CardDescription" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
      <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Margin" Value="0,0,0,7" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
          <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
          <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
          <Setter Property="Foreground" Value="#FFFFFF" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
          <Setter Property="FontWeight" Value="Bold" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,0,0,1" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="56" Height="56"
               Source="/Cartomize.ArcGISPro;component/Images/Cartomize.png"
               Stretch="Uniform" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Cartomize" FontSize="18" FontWeight="Bold"
                     Foreground="{StaticResource NavyBrush}" />
          <TextBlock Text="Automatisation et mise en page pour ArcGIS Pro"
                     FontSize="11" Foreground="{StaticResource MutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Background="#FFFFFF" BorderThickness="0">
      <TabItem Header="Automatisation">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Automatisation" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Analysez le projet et créez une carte ArcGIS Pro native en suivant un flux explicable."
                       Style="{StaticResource PageDescription}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Automatisation cartographique" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Les outils utilisent les cartes, couches et maquettes du projet courant."
                           Style="{StaticResource CardDescription}" />
                <Button Content="Créer automatiquement une carte" Command="{Binding AutopilotCommand}"
                        Style="{StaticResource PrimaryActionButton}" />
                <Button Content="Rejouer une recette Cartomize" Command="{Binding ReplayCommand}"
                        Style="{StaticResource ActionButton}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Projet">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Projet" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Consultez le projet, analysez une couche et appliquez des traitements Cartomize réversibles."
                       Style="{StaticResource PageDescription}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Intelligence cartographique" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Sélectionnez les données dans les outils ArcGIS Pro avant l’exécution."
                           Style="{StaticResource CardDescription}" />
                <Button Content="Analyser une couche avec Vector Intelligence" Command="{Binding VectorCommand}"
                        Style="{StaticResource PrimaryActionButton}" />
                <Button Content="Analyser un raster avec Raster Engine" Command="{Binding RasterCommand}"
                        Style="{StaticResource ActionButton}" />
                <Button Content="Analyser l’intelligence cartographique du projet" Command="{Binding GeoCommand}"
                        Style="{StaticResource ActionButton}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Mise en page">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Mise en page" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Choisissez une maquette et produisez une mise en page ArcGIS Pro native entièrement modifiable."
                       Style="{StaticResource PageDescription}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Catalogue de maquettes" Style="{StaticResource CardTitle}" />
                <TextBlock Text="24 maquettes Cartomize sont disponibles hors connexion."
                           Style="{StaticResource CardDescription}" />
                <Button Content="Créer une mise en page Cartomize" Command="{Binding LayoutCommand}"
                        Style="{StaticResource PrimaryActionButton}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Qualité">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Qualité" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Contrôlez la cohérence du projet et surveillez les changements avant publication."
                       Style="{StaticResource PageDescription}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Contrôle de la qualité" Style="{StaticResource CardTitle}" />
                <Button Content="Contrôler la qualité cartographique du projet" Command="{Binding AuditCommand}"
                        Style="{StaticResource PrimaryActionButton}" />
                <Button Content="Vérifier les changements MapOps" Command="{Binding MapOpsCommand}"
                        Style="{StaticResource ActionButton}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Production">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Production" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Produisez des séries de cartes et rejouez les décisions cartographiques enregistrées."
                       Style="{StaticResource PageDescription}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Production en série" Style="{StaticResource CardTitle}" />
                <Button Content="Produire une série de cartes Cartomize" Command="{Binding BatchCommand}"
                        Style="{StaticResource PrimaryActionButton}" />
                <Button Content="Rejouer une recette Cartomize" Command="{Binding ReplayCommand}"
                        Style="{StaticResource ActionButton}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Communauté">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Communauté" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Accédez au portail officiel Cartomize et aux ressources de la communauté."
                       Style="{StaticResource PageDescription}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Portail Cartomize" Style="{StaticResource CardTitle}" />
                <TextBlock Text="Aucune donnée du projet ArcGIS Pro n’est transmise au portail."
                           Style="{StaticResource CardDescription}" />
                <Button Content="Ouvrir le portail Cartomize" Command="{Binding CommunityCommand}"
                        Style="{StaticResource PrimaryActionButton}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Système">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <TextBlock Text="Système" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Vérifiez la disponibilité des composants requis et l’état technique de Cartomize."
                       Style="{StaticResource PageDescription}" />
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Diagnostic" Style="{StaticResource CardTitle}" />
                <TextBlock Text="ArcGIS Pro 3.7&#x0a;.NET 10&#x0a;24 maquettes hors ligne&#x0a;Boîte à outils Python Cartomize"
                           Foreground="{StaticResource TextBrush}" FontSize="12" LineHeight="20" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="0,1,0,0" Padding="10,6">
      <TextBlock Text="{Binding VersionText}" FontSize="10"
                 Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
