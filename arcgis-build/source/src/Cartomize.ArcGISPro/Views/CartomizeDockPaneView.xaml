<UserControl x:Class="Cartomize.ArcGISPro.Views.CartomizeDockPaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420">
  <UserControl.Resources>
    <!-- ArcGIS Pro fournit les couleurs, les polices et les états bleus de sélection. -->
    <Style TargetType="TextBlock" BasedOn="{DynamicResource Esri_TextBlockRegular}" />
    <Style TargetType="Label">
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="5" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="4" />
      <Setter Property="MinHeight" Value="30" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="CanUserAddRows" Value="False" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock"
           BasedOn="{DynamicResource Esri_TextBlockH1}">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="DescriptionStyle" TargetType="TextBlock"
           BasedOn="{DynamicResource Esri_TextBlockRegular}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock"
           BasedOn="{DynamicResource Esri_TextBlockH3}">
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Esri_BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12,11,12,12" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{DynamicResource Esri_ButtonBorderless}">
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,3" />
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>

  <Grid Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0"
            Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
            BorderBrush="{DynamicResource Esri_BorderBrush}"
            BorderThickness="0,0,0,1" Padding="12,10">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="66" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="56" Height="56"
               Source="/Cartomize.ArcGISPro;component/Images/Cartomize.png" Stretch="Uniform" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Cartomize" Style="{DynamicResource Esri_TextBlockDockPaneHeading}" />
          <TextBlock Text="Automatisation et mise en page pour ArcGIS Pro"
                     Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Grid.Row="1" Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
                BorderThickness="0" TabStripPlacement="Top">
      <TabItem Header="Automatisation">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Automatisation" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Analysez le projet, comparez plusieurs propositions et créez une carte ArcGIS Pro native en suivant un plan explicable."
                       Style="{StaticResource DescriptionStyle}" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Préparer l’analyse" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Définissez l’objectif et les données à prendre en compte. Les valeurs automatiques conviennent à la plupart des projets."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Content="Objectif" Margin="0,6,12,0" />
                  <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="Détection automatique" /><ComboBoxItem Content="Carte administrative" />
                    <ComboBoxItem Content="Aménagement du territoire" /><ComboBoxItem Content="Occupation du sol" />
                    <ComboBoxItem Content="Carte de risques" /><ComboBoxItem Content="Hydrologie" />
                    <ComboBoxItem Content="Environnement" /><ComboBoxItem Content="Agriculture" />
                    <ComboBoxItem Content="Transport et accessibilité" /><ComboBoxItem Content="Urbanisme" />
                    <ComboBoxItem Content="Démographie" /><ComboBoxItem Content="Biodiversité" />
                    <ComboBoxItem Content="Énergie" /><ComboBoxItem Content="Santé" />
                    <ComboBoxItem Content="Humanitaire" /><ComboBoxItem Content="Publication scientifique" />
                    <ComboBoxItem Content="Topographie" /><ComboBoxItem Content="Atlas territorial" />
                  </ComboBox>
                  <Label Grid.Row="1" Content="Couche principale" Margin="0,6,12,0" />
                  <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding LayerNames}" SelectedItem="{Binding SelectedLayerName}" />
                  <Label Grid.Row="2" Content="Style de composition" Margin="0,6,12,0" />
                  <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="Équilibré" /><ComboBoxItem Content="Institutionnel" />
                    <ComboBoxItem Content="Analytique" /><ComboBoxItem Content="Minimaliste" />
                  </ComboBox>
                  <Label Grid.Row="3" Content="Sources" Margin="0,6,12,0" />
                  <TextBox Grid.Row="3" Grid.Column="1" ToolTip="Sources, année et crédits cartographiques" />
                </Grid>
                <CheckBox Content="Utiliser les couches affichées dans ArcGIS Pro" IsChecked="True" />
                <CheckBox Content="Harmoniser la symbologie du projet (peut remplacer les styles actuels)" />
                <CheckBox Content="Corriger automatiquement la lisibilité" IsChecked="True" />
                <Button Content="Analyser le projet" Command="{Binding AnalyzeAutomationCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Plan cartographique recommandé" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Le rapport présente les décisions proposées avant toute modification du projet."
                           Style="{StaticResource DescriptionStyle}" />
                <TextBox Text="Lancez l’analyse pour obtenir une recommandation structurée."
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="170" />
                <ProgressBar Minimum="0" Maximum="100" Value="0" MinHeight="18" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Propositions" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Comparez les variantes selon leur score, leur maquette et les principales décisions de composition."
                           Style="{StaticResource DescriptionStyle}" />
                <DataGrid MinHeight="220">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Score" Width="Auto" />
                    <DataGridTextColumn Header="Proposition" Width="Auto" />
                    <DataGridTextColumn Header="Maquette" Width="Auto" />
                    <DataGridTextColumn Header="Format" Width="Auto" />
                    <DataGridTextColumn Header="Décisions" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Content="Maquette" Margin="0,6,12,0" /><ComboBox Grid.Row="0" Grid.Column="1" />
                  <Label Grid.Row="1" Content="Titre" Margin="0,6,12,0" /><TextBox Grid.Row="1" Grid.Column="1" />
                  <Label Grid.Row="2" Content="Sous-titre" Margin="0,6,12,0" /><TextBox Grid.Row="2" Grid.Column="1" />
                  <Label Grid.Row="3" Content="Marge d’emprise" Margin="0,6,12,0" /><TextBox Grid.Row="3" Grid.Column="1" Text="3 %" />
                  <Label Grid.Row="4" Content="Contexte cartographique" Margin="0,6,12,0" /><ComboBox Grid.Row="4" Grid.Column="1" />
                  <Label Grid.Row="5" Content="Opacité du contexte" Margin="0,6,12,0" /><TextBox Grid.Row="5" Grid.Column="1" Text="100 %" />
                  <Label Grid.Row="6" Content="Carte de situation" Margin="0,6,12,0" /><ComboBox Grid.Row="6" Grid.Column="1" />
                  <Label Grid.Row="7" Content="Grille" Margin="0,6,12,0" /><CheckBox Grid.Row="7" Grid.Column="1" Content="Afficher une grille de coordonnées" />
                  <Label Grid.Row="8" Content="Validation" Margin="0,6,12,0" /><CheckBox Grid.Row="8" Grid.Column="1" Content="Décisions vérifiées par le cartographe" />
                </Grid>
                <Button Content="Créer la proposition sélectionnée" Command="{Binding AutopilotCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="Créer les trois propositions" Command="{Binding GenerateAllCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Recettes réutilisables" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Enregistrez les décisions cartographiques pour reproduire la même carte avec de nouvelles données."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button Content="Enregistrer la recette" Command="{Binding SaveRecipeCommand}"
                          Style="{StaticResource SecondaryButtonStyle}" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Rejouer une recette" Command="{Binding ReplayCommand}"
                          Style="{StaticResource SecondaryButtonStyle}" Margin="4,3,0,3" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Projet">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Projet" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Consultez l’état du projet, sélectionnez une couche et appliquez une recommandation de symbologie réversible."
                       Style="{StaticResource DescriptionStyle}" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Vue d’ensemble du projet" Style="{StaticResource SectionTitleStyle}" />
                <TextBox Text="{Binding ProjectSummary}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="150" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Couche active" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Les actions utilisent la couche choisie ici, sans modifier les autres couches du projet."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Label Content="Couche" Margin="0,6,12,0" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding LayerNames}" SelectedItem="{Binding SelectedLayerName}" />
                </Grid>
                <Button Content="Importer des données…" Command="{Binding ImportDataCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button Content="Afficher l’emprise" Command="{Binding ZoomLayerCommand}"
                          Style="{StaticResource SecondaryButtonStyle}" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Ouvrir les propriétés" Command="{Binding LayerPropertiesCommand}"
                          Style="{StaticResource SecondaryButtonStyle}" Margin="4,3,0,3" />
                </Grid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Recommandation de symbologie" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="L’analyse est lancée uniquement sur demande afin de préserver la réactivité d’ArcGIS Pro, y compris avec des couches volumineuses ou distantes."
                           Style="{StaticResource DescriptionStyle}" />
                <Button Content="Analyser la couche sélectionnée" Command="{Binding AnalyzeLayerCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <TextBox Text="{Binding RecommendationText}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" MinHeight="190" />
                <Border Style="{StaticResource CardStyle}" Margin="0,8,0,8">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Mode de rendu" Margin="0,6,12,0" />
                    <ComboBox Grid.Row="0" Grid.Column="1" SelectedIndex="0">
                      <ComboBoxItem Content="Symbole unique" /><ComboBoxItem Content="Catégorisé" /><ComboBoxItem Content="Gradué — quantiles" />
                    </ComboBox>
                    <Label Grid.Row="1" Content="Champ thématique" Margin="0,6,12,0" /><ComboBox Grid.Row="1" Grid.Column="1" />
                    <Label Grid.Row="2" Content="Nombre maximal de classes" Margin="0,6,12,0" /><TextBox Grid.Row="2" Grid.Column="1" Text="5" />
                    <Label Grid.Row="3" Content="Palette" Margin="0,6,12,0" />
                    <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="0">
                      <ComboBoxItem Content="Qualitative" /><ComboBoxItem Content="Séquentielle" /><ComboBoxItem Content="Divergente" />
                    </ComboBox>
                    <Label Grid.Row="4" Content="Champ d’étiquette" Margin="0,6,12,0" /><ComboBox Grid.Row="4" Grid.Column="1" />
                    <Label Grid.Row="5" Content="Étiquetage" Margin="0,6,12,0" /><CheckBox Grid.Row="5" Grid.Column="1" Content="Activer les étiquettes" />
                    <Label Grid.Row="6" Content="Taille des étiquettes" Margin="0,6,12,0" /><TextBox Grid.Row="6" Grid.Column="1" Text="9,5 pt" />
                    <Label Grid.Row="7" Content="Placement" Margin="0,6,12,0" />
                    <ComboBox Grid.Row="7" Grid.Column="1" SelectedIndex="0">
                      <ComboBoxItem Content="Automatique selon la géométrie" /><ComboBoxItem Content="Autour du point" />
                      <ComboBoxItem Content="Sur le point" /><ComboBoxItem Content="Le long de la ligne" />
                      <ComboBoxItem Content="Courbe" /><ComboBoxItem Content="Horizontal" /><ComboBoxItem Content="Libre" />
                    </ComboBox>
                    <Label Grid.Row="8" Content="Opacité de la couche" Margin="0,6,12,0" /><TextBox Grid.Row="8" Grid.Column="1" Text="100 %" />
                    <Label Grid.Row="9" Content="Validation" Margin="0,6,12,0" /><CheckBox Grid.Row="9" Grid.Column="1" Content="Confirmer les paramètres avant application" />
                  </Grid>
                </Border>
                <Button Content="Appliquer la recommandation" Command="{Binding ApplyRecommendationCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="Restaurer le style précédent" Command="{Binding UndoStyleCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Ouvrir Raster Engine" Command="{Binding RasterCommand}"
                        IsEnabled="{Binding IsRasterLayer}" Style="{StaticResource SecondaryButtonStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Mise en page">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Mise en page" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Choisissez une maquette, renseignez les informations essentielles et produisez une mise en page ArcGIS Pro native entièrement modifiable."
                       Style="{StaticResource DescriptionStyle}" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Catalogue de maquettes" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Utilisez la recherche et les catégories pour parcourir les maquettes ArcGIS Pro disponibles hors connexion."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Label Content="Recherche" /><Label Grid.Column="1" Content="Catégorie" Margin="8,0,0,0" />
                  <TextBox Grid.Row="1" ToolTip="Rechercher par titre, thème ou usage" />
                  <ComboBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,0" SelectedIndex="0">
                    <ComboBoxItem Content="Toutes les catégories" /><ComboBoxItem Content="Administration" /><ComboBoxItem Content="Agriculture" />
                    <ComboBoxItem Content="Aménagement du territoire" /><ComboBoxItem Content="Atlas" /><ComboBoxItem Content="Biodiversité" />
                    <ComboBoxItem Content="Démographie" /><ComboBoxItem Content="Énergie" /><ComboBoxItem Content="Environnement" />
                    <ComboBoxItem Content="Humanitaire" /><ComboBoxItem Content="Hydrologie" /><ComboBoxItem Content="Occupation du sol" />
                    <ComboBoxItem Content="Risques" /><ComboBoxItem Content="Santé" /><ComboBoxItem Content="Publication scientifique" />
                    <ComboBoxItem Content="Topographie" /><ComboBoxItem Content="Transport" /><ComboBoxItem Content="Urbanisme" />
                  </ComboBox>
                </Grid>
                <ListBox MinHeight="190" Margin="0,8,0,8" />
                <TextBlock Text="Détails de la maquette" Style="{DynamicResource Esri_TextBlockRegular}" />
                <TextBox IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="145" Margin="0,4,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Contenu de la carte" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Ces informations sont ajoutées à la composition et restent modifiables dans le concepteur ArcGIS Pro."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <Label Grid.Row="0" Content="Titre" Margin="0,6,12,0" /><TextBox Grid.Row="0" Grid.Column="1" ToolTip="Titre principal de la carte" />
                  <Label Grid.Row="1" Content="Sous-titre" Margin="0,6,12,0" /><TextBox Grid.Row="1" Grid.Column="1" ToolTip="Sous-titre ou période d’analyse" />
                  <Label Grid.Row="2" Content="Sources" Margin="0,6,12,0" /><TextBox Grid.Row="2" Grid.Column="1" ToolTip="Sources, auteur et date" />
                  <Label Grid.Row="3" Content="Marge cartographique" Margin="0,6,12,0" /><TextBox Grid.Row="3" Grid.Column="1" Text="3 %" />
                  <Label Grid.Row="4" Content="Contexte cartographique" Margin="0,6,12,0" /><ComboBox Grid.Row="4" Grid.Column="1" />
                  <Label Grid.Row="5" Content="Opacité du contexte" Margin="0,6,12,0" /><TextBox Grid.Row="5" Grid.Column="1" Text="100 %" />
                  <Label Grid.Row="6" Content="Carte de situation" Margin="0,6,12,0" /><ComboBox Grid.Row="6" Grid.Column="1" />
                </Grid>
                <CheckBox Content="Utiliser les couches affichées dans ArcGIS Pro" IsChecked="True" />
                <CheckBox Content="Ajouter une grille au cadre principal" />
                <Button Content="Créer la mise en page" Command="{Binding LayoutCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="Actualiser la mise en page" Command="{Binding SynchronizeLayoutCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Ouvrir l’aperçu HD dans ArcGIS Pro" Command="{Binding OpenLayoutCommand}" Style="{StaticResource SecondaryButtonStyle}" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Aperçu et export" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Sélectionnez une mise en page existante, améliorez son rendu puis choisissez un format de sortie."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Label Content="Mise en page" Margin="0,6,12,0" /><ComboBox Grid.Column="1" />
                </Grid>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Button Content="Actualiser l’aperçu HD" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Améliorer la lisibilité" Command="{Binding OptimizeLayoutCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,3,0,3" />
                </Grid>
                <TextBlock Text="Formats de sortie" Style="{DynamicResource Esri_TextBlockRegular}" Margin="0,6,0,2" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Button Content="Exporter en PDF" Command="{Binding ExportLayoutCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Exporter en SVG" Command="{Binding ExportLayoutCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,3,0,3" />
                  <Button Grid.Row="1" Content="Exporter en PNG" Command="{Binding ExportLayoutCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,3,4,3" />
                  <Button Grid.Row="1" Grid.Column="1" Content="Enregistrer en PAGX" Command="{Binding ExportLayoutCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,3,0,3" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Qualité">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Qualité" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Contrôlez la cohérence du projet et des mises en page avant publication. Chaque anomalie est accompagnée d’une action recommandée."
                       Style="{StaticResource DescriptionStyle}" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Résultat du contrôle" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Score non évalué" Style="{DynamicResource Esri_TextBlockH1}" />
                <Button Content="Lancer le contrôle de la qualité" Command="{Binding AuditCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="Vérifier le placement des étiquettes" Command="{Binding LabelAuditCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock Text="Étiquettes non évaluées" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Observations" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Sélectionnez une ligne pour examiner le niveau, la couche concernée et la correction proposée."
                           Style="{StaticResource DescriptionStyle}" />
                <DataGrid MinHeight="330">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Niveau" Width="Auto" /><DataGridTextColumn Header="Code" Width="Auto" />
                    <DataGridTextColumn Header="Couche" Width="Auto" /><DataGridTextColumn Header="Observation et action recommandée" Width="*" />
                  </DataGrid.Columns>
                </DataGrid>
                <Button Content="Copier le rapport" Command="{Binding CopyReportCommand}" Style="{StaticResource SecondaryButtonStyle}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Production">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Production" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Produisez des séries de cartes, surveillez les changements du projet et formalisez la validation du cartographe."
                       Style="{StaticResource DescriptionStyle}" />
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Production en série" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Un manifeste JSON décrit les cartes à produire, les variables et les formats de sortie."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox ToolTip="Chemin du manifeste de production" /><Button Grid.Column="1" Content="Parcourir" Command="{Binding SelectManifestCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,3,0,3" />
                </Grid>
                <Button Content="Créer un manifeste" Command="{Binding CreateManifestCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Exécuter la série" Command="{Binding BatchCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <TextBox Text="Sélectionnez ou créez un manifeste. Cartomize peut produire jusqu’à 5 000 cartes par série."
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="135" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Suivi MapOps" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="Comparez l’état actuel du projet à une référence et identifiez les cartes à régénérer."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Button Content="Créer l’état de référence" Command="{Binding MapOpsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,3,4,3" />
                  <Button Grid.Column="1" Content="Vérifier les changements" Command="{Binding MapOpsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="4,3,0,3" />
                  <Button Grid.Row="1" Content="Accepter l’état actuel" Command="{Binding MapOpsCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,3,4,3" />
                  <Button Grid.Row="1" Grid.Column="1" Content="Régénérer la dernière recette" Command="{Binding ReplayCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="4,3,0,3" />
                </Grid>
                <CheckBox Content="Régénérer automatiquement la dernière recette lorsque des données utilisées changent" />
                <TextBox Text="Aucun changement vérifié." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="Validation cartographique" Style="{StaticResource SectionTitleStyle}" />
                <TextBlock Text="L’approbation humaine reste distincte du score automatique et produit un certificat traçable."
                           Style="{StaticResource DescriptionStyle}" />
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Label Content="Réviseur" Margin="0,6,12,0" /><TextBox Grid.Column="1" ToolTip="Nom du cartographe responsable" />
                  <Label Grid.Row="1" Content="Organisation" Margin="0,6,12,0" /><TextBox Grid.Row="1" Grid.Column="1" ToolTip="Organisation" />
                </Grid>
                <TextBlock Text="Liste de contrôle obligatoire" Style="{DynamicResource Esri_TextBlockRegular}" Margin="0,8,0,2" />
                <CheckBox Content="Les sources, dates et limites des données sont vérifiées." />
                <CheckBox Content="Le CRS, l’emprise et l’échelle correspondent à l’objectif de la carte." />
                <CheckBox Content="La symbologie représente correctement les variables et les classes." />
                <CheckBox Content="Les étiquettes sont lisibles, sans ambiguïté ni collision majeure." />
                <CheckBox Content="Le titre, la légende, l’échelle, le nord et les crédits sont cohérents." />
                <CheckBox Content="Le contraste, la taille des textes et les couleurs sont accessibles." />
                <CheckBox Content="Le fichier exporté a été ouvert et contrôlé au niveau de zoom requis." />
                <TextBlock Text="Notes et réserves" Style="{DynamicResource Esri_TextBlockRegular}" Margin="0,8,0,2" />
                <TextBox ToolTip="Précisez les limites des données, les réserves ou les corrections demandées."
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="110" />
                <Button Content="Approuver la mise en page" Command="{Binding ApproveLayoutCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                <Button Content="Exporter le certificat" Command="{Binding ExportCertificateCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock Text="Statut : en attente de validation humaine" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Communauté">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Communauté" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Accédez au portail officiel Cartomize et aux maquettes disponibles hors ligne."
                       Style="{StaticResource DescriptionStyle}" />
            <Border Style="{StaticResource CardStyle}"><StackPanel>
              <TextBlock Text="Portail Cartomize" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Text="Consultez les maquettes publiées et les ressources de la communauté." Style="{StaticResource DescriptionStyle}" />
              <TextBlock Text="Le portail s’ouvre dans votre navigateur. Aucune donnée du projet ArcGIS Pro n’est transmise." TextWrapping="Wrap" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
              <TextBlock Text="Maquettes hors ligne" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Text="24 maquettes disponibles hors ligne." Style="{StaticResource DescriptionStyle}" />
              <TextBlock Text="Elles restent accessibles lorsque le portail ou Internet est indisponible." Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
            </StackPanel></Border>
            <Border Style="{StaticResource CardStyle}"><StackPanel>
              <TextBlock Text="Ressources en ligne" Style="{StaticResource SectionTitleStyle}" />
              <TextBlock Text="Actualisez la liste des ressources publiées sur le portail officiel." Style="{StaticResource DescriptionStyle}" />
              <ListBox MinHeight="190" />
              <Button Content="Actualiser le catalogue en ligne" Command="{Binding RefreshCommunityCommand}" Style="{StaticResource SecondaryButtonStyle}" />
              <Button Content="Ouvrir la ressource sélectionnée" Command="{Binding CommunityCommand}" Style="{StaticResource PrimaryButtonStyle}" />
              <Button Content="Ouvrir le portail Cartomize" Command="{Binding CommunityCommand}" Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Système">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12">
            <TextBlock Text="Système" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Vérifiez la disponibilité des composants ArcGIS Pro requis et consultez l’état technique du plugin."
                       Style="{StaticResource DescriptionStyle}" />
            <Border Style="{StaticResource CardStyle}"><StackPanel>
              <TextBlock Text="Diagnostic" Style="{StaticResource SectionTitleStyle}" />
              <TextBox Text="{Binding DiagnosticText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="360" />
              <Button Content="Actualiser l’état du système" Command="{Binding DiagnosticsCommand}" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="2"
            Background="{DynamicResource Esri_DockPaneClientAreaBackgroundBrush}"
            BorderBrush="{DynamicResource Esri_BorderBrush}"
            BorderThickness="0,1,0,0" Padding="10,5">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding FooterStatus}" Style="{DynamicResource Esri_TextBlockRegular}" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding VersionText}" Style="{DynamicResource Esri_TextBlockH7}" Margin="8,0,0,0" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
