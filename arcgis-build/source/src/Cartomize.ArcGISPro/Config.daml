<?xml version="1.0" encoding="utf-8"?>
<ArcGIS defaultAssembly="Cartomize.ArcGISPro.dll"
        defaultNamespace="Cartomize.ArcGISPro"
        xmlns="http://schemas.esri.com/DADF/Registry"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <AddInInfo id="{8D473903-AE50-4C2B-A11C-E54CD231C051}"
             version="10.5.1.3"
             desktopVersion="3.7.0">
    <Name>Cartomize for ArcGIS Pro</Name>
    <Description>Assistant professionnel de cartographie, diagnostic, mise en page et production par lots.</Description>
    <Image>Images\Cartomize.png</Image>
    <Author>ONDON NKOUA Cédrick Belmich</Author>
    <Company>Cartomize</Company>
    <Date>2026-08-26</Date>
    <Subject>Mapping and Visualization</Subject>
  </AddInInfo>

  <modules>
    <insertModule id="Cartomize_ArcGISPro_Module"
                  className="Module"
                  autoLoad="false"
                  caption="Cartomize">
      <tabs>
        <tab id="Cartomize_ArcGISPro_Tab" caption="Cartomize" keytip="CZ">
          <group refID="Cartomize_ArcGISPro_MainGroup" />
        </tab>
      </tabs>

      <groups>
        <group id="Cartomize_ArcGISPro_MainGroup" caption="Cartomize" appearsOnAddInTab="false">
          <button refID="Cartomize_ArcGISPro_OpenDockPane" size="large" />
        </group>
      </groups>

      <controls>
        <button id="Cartomize_ArcGISPro_OpenDockPane" caption="Ouvrir Cartomize" className="Commands.OpenDockPaneButton" loadOnClick="true" smallImage="Images\Cartomize.png" largeImage="Images\Cartomize.png" />
      </controls>

      <dockPanes>
        <dockPane id="Cartomize_ArcGISPro_DockPane"
                  caption="Cartomize"
                  className="Views.CartomizeDockPaneViewModel"
                  dock="group"
                  dockWith="esri_core_contentsDockPane"
                  condition="esri_mapping_MapView">
          <content className="Views.CartomizeDockPaneView" />
        </dockPane>
      </dockPanes>
    </insertModule>
  </modules>
</ArcGIS>
